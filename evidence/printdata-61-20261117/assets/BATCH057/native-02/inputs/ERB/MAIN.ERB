@SYSTEM_TITLE
#DIM ZZPDN,64
#DIMS ZZPDSENT,64
#DIM ZZPDNEXT
#DIM ZZPDSELECT
#DIM ZZPDRESET
PRINTL DERIVED_BEGIN EMPTY_PRINTFORMSW
OUTPUTLOG
A=0
B=0
RESULT:0=777
RESULT:1=776
RESULTS:0 = PLAN_RESULT_STRING
D:0=90
D:1=99
D:2=92
LOCALS:0 = PLAN_LOCAL_STRING
ZZPDN:0=1000
ZZPDSENT:0 = ROLE_0_EMPTY_PRINTFORMSW
PRINTFORML ROLE_BEFORE EMPTY_PRINTFORMSW SLOT=0 N={ZZPDN:0} S=[%ZZPDSENT:0%]
RANDOMIZE 0
ZZPDSELECT=-99
ZZPDNEXT=RAND:100
PRINTFORML RNG_CONTROL EMPTY_PRINTFORMSW PICK={ZZPDSELECT} NEXT={ZZPDNEXT}
RANDOMIZE 0
PRINTFORML INPUT EMPTY_PRINTFORMSW D={D:0},{D:1},{D:2} LOCAL=[%LOCALS:0%] R={RESULT:0} R1={RESULT:1} S=[%RESULTS:0%] A={A} B={B} NSIZE={VARSIZE("ZZPDN")} SSIZE={VARSIZE("ZZPDSENT")}
PRINTL TARGET_BEFORE EMPTY_PRINTFORMSW
OUTPUTLOG
PRINTFORMSW ZZPDEMPTY()
PRINTL TARGET_AFTER EMPTY_PRINTFORMSW
ZZPDRESET=RAND:100
PRINTFORML STATE EMPTY_PRINTFORMSW R={RESULT:0} R1={RESULT:1} S=[%RESULTS:0%] DEST={D:1} GUARD={D:0},{D:2} LOCAL=[%LOCALS:0%] A={A} B={B} NEXT={ZZPDRESET} CONTROL={ZZPDNEXT}
PRINTFORML ROLE_AFTER EMPTY_PRINTFORMSW SLOT=0 N={ZZPDN:0} S=[%ZZPDSENT:0%]
PRINTL FOLLOW EMPTY_PRINTFORMSW
OUTPUTLOG
PRINTL DERIVED_DONE EMPTY_PRINTFORMSW
OUTPUTLOG
QUIT
@ZZPDINDEX
#FUNCTION
A+=1
B=B*10+1
PRINTFORML ARG INDEX COUNT={A} ORDER={B} VALUE=1
RETURNF 1
@ZZPDSTRINDEX
#FUNCTION
A+=1
B=B*10+1
PRINTFORML ARG STRINDEX COUNT={A} ORDER={B} VALUE=0
RETURNF 0
@ZZPDGOOD
#FUNCTION
A+=1
B=B*10+2
PRINTFORML ARG GOOD COUNT={A} ORDER={B} CHOICE_AT_FORM={D:1}
RETURNF 11
@ZZPDBAD
#FUNCTION
A+=1
B=B*10+3
PRINTFORML ARG BAD COUNT={A} ORDER={B} CHOICE_AT_FORM={D:1}
RETURNF 1/ZZPDZERO()
@ZZPDZERO
#FUNCTION
RETURNF 0
@ZZPDS
#FUNCTIONS
A+=1
B=B*10+4
PRINTFORML ARG STRING COUNT={A} ORDER={B}
RETURNF "A  B"
@ZZPDFORM
#FUNCTIONS
A+=1
B=B*10+5
PRINTFORML ARG FORMSTRING COUNT={A} ORDER={B}
RETURNF "X  Y={ZZPDGOOD()}"
@ZZPDEMPTY
#FUNCTIONS
A+=1
B=B*10+6
PRINTFORML ARG EMPTY COUNT={A} ORDER={B}
RETURNF ""
@ZZPDMALFORMED
#FUNCTIONS
A+=1
B=B*10+7
PRINTFORML ARG MALFORMED COUNT={A} ORDER={B}
RETURNF "{"
