@SYSTEM_TITLE
#DIM ZZPDN,64
#DIMS ZZPDSENT,64
#DIM ZZPDNEXT
#DIM ZZPDSELECT
#DIM ZZPDRESET
PRINTL DERIVED_BEGIN CHOICE_GOOD_PRINTDATAK
OUTPUTLOG
A=0
B=0
RESULT:0=777
RESULT:1=776
RESULTS:0 = PLAN_RESULT_STRING
D:0=90
D:1=99
D:2=92
LOCALS:0 = PLAN_LOCAL_STRING
ZZPDN:0=1000
ZZPDSENT:0 = ROLE_0_CHOICE_GOOD_PRINTDATAK
PRINTFORML ROLE_BEFORE CHOICE_GOOD_PRINTDATAK SLOT=0 N={ZZPDN:0} S=[%ZZPDSENT:0%]
ZZPDN:1=1001
ZZPDSENT:1 = ROLE_1_CHOICE_GOOD_PRINTDATAK
PRINTFORML ROLE_BEFORE CHOICE_GOOD_PRINTDATAK SLOT=1 N={ZZPDN:1} S=[%ZZPDSENT:1%]
ZZPDN:2=1002
ZZPDSENT:2 = ROLE_2_CHOICE_GOOD_PRINTDATAK
PRINTFORML ROLE_BEFORE CHOICE_GOOD_PRINTDATAK SLOT=2 N={ZZPDN:2} S=[%ZZPDSENT:2%]
ZZPDN:3=1003
ZZPDSENT:3 = ROLE_3_CHOICE_GOOD_PRINTDATAK
PRINTFORML ROLE_BEFORE CHOICE_GOOD_PRINTDATAK SLOT=3 N={ZZPDN:3} S=[%ZZPDSENT:3%]
ZZPDN:4=1004
ZZPDSENT:4 = ROLE_4_CHOICE_GOOD_PRINTDATAK
PRINTFORML ROLE_BEFORE CHOICE_GOOD_PRINTDATAK SLOT=4 N={ZZPDN:4} S=[%ZZPDSENT:4%]
ZZPDN:5=1005
ZZPDSENT:5 = ROLE_5_CHOICE_GOOD_PRINTDATAK
PRINTFORML ROLE_BEFORE CHOICE_GOOD_PRINTDATAK SLOT=5 N={ZZPDN:5} S=[%ZZPDSENT:5%]
RANDOMIZE 0
ZZPDSELECT=RAND:2
ZZPDNEXT=RAND:100
PRINTFORML RNG_CONTROL CHOICE_GOOD_PRINTDATAK PICK={ZZPDSELECT} NEXT={ZZPDNEXT}
RANDOMIZE 0
PRINTFORML INPUT CHOICE_GOOD_PRINTDATAK D={D:0},{D:1},{D:2} LOCAL=[%LOCALS:0%] R={RESULT:0} R1={RESULT:1} S=[%RESULTS:0%] A={A} B={B} NSIZE={VARSIZE("ZZPDN")} SSIZE={VARSIZE("ZZPDSENT")}
PRINTL TARGET_BEFORE CHOICE_GOOD_PRINTDATAK
OUTPUTLOG
PRINTDATAK D:ZZPDINDEX()
DATAFORM PRINTDATAK_GOOD{ZZPDGOOD()}
DATAFORM PRINTDATAK_BAD{ZZPDBAD()}
ENDDATA
PRINTL TARGET_AFTER CHOICE_GOOD_PRINTDATAK
ZZPDRESET=RAND:100
PRINTFORML STATE CHOICE_GOOD_PRINTDATAK R={RESULT:0} R1={RESULT:1} S=[%RESULTS:0%] DEST={D:1} GUARD={D:0},{D:2} LOCAL=[%LOCALS:0%] A={A} B={B} NEXT={ZZPDRESET} CONTROL={ZZPDNEXT}
PRINTFORML ROLE_AFTER CHOICE_GOOD_PRINTDATAK SLOT=0 N={ZZPDN:0} S=[%ZZPDSENT:0%]
PRINTFORML ROLE_AFTER CHOICE_GOOD_PRINTDATAK SLOT=1 N={ZZPDN:1} S=[%ZZPDSENT:1%]
PRINTFORML ROLE_AFTER CHOICE_GOOD_PRINTDATAK SLOT=2 N={ZZPDN:2} S=[%ZZPDSENT:2%]
PRINTFORML ROLE_AFTER CHOICE_GOOD_PRINTDATAK SLOT=3 N={ZZPDN:3} S=[%ZZPDSENT:3%]
PRINTFORML ROLE_AFTER CHOICE_GOOD_PRINTDATAK SLOT=4 N={ZZPDN:4} S=[%ZZPDSENT:4%]
PRINTFORML ROLE_AFTER CHOICE_GOOD_PRINTDATAK SLOT=5 N={ZZPDN:5} S=[%ZZPDSENT:5%]
PRINTL FOLLOW CHOICE_GOOD_PRINTDATAK
OUTPUTLOG
PRINTL DERIVED_DONE CHOICE_GOOD_PRINTDATAK
OUTPUTLOG
QUIT
@ZZPDINDEX
#FUNCTION
A+=1
B=B*10+1
PRINTFORML ARG INDEX COUNT={A} ORDER={B} VALUE=1
RETURNF 1
@ZZPDSTRINDEX
#FUNCTION
A+=1
B=B*10+1
PRINTFORML ARG STRINDEX COUNT={A} ORDER={B} VALUE=0
RETURNF 0
@ZZPDGOOD
#FUNCTION
A+=1
B=B*10+2
PRINTFORML ARG GOOD COUNT={A} ORDER={B} CHOICE_AT_FORM={D:1}
RETURNF 11
@ZZPDBAD
#FUNCTION
A+=1
B=B*10+3
PRINTFORML ARG BAD COUNT={A} ORDER={B} CHOICE_AT_FORM={D:1}
RETURNF 1/ZZPDZERO()
@ZZPDZERO
#FUNCTION
RETURNF 0
@ZZPDS
#FUNCTIONS
A+=1
B=B*10+4
PRINTFORML ARG STRING COUNT={A} ORDER={B}
RETURNF "A  B"
@ZZPDFORM
#FUNCTIONS
A+=1
B=B*10+5
PRINTFORML ARG FORMSTRING COUNT={A} ORDER={B}
RETURNF "X  Y={ZZPDGOOD()}"
@ZZPDEMPTY
#FUNCTIONS
A+=1
B=B*10+6
PRINTFORML ARG EMPTY COUNT={A} ORDER={B}
RETURNF ""
@ZZPDMALFORMED
#FUNCTIONS
A+=1
B=B*10+7
PRINTFORML ARG MALFORMED COUNT={A} ORDER={B}
RETURNF "{"
