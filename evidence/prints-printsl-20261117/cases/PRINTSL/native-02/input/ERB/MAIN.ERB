@SYSTEM_TITLE
A=0
B=71
RESULT=701
RESULTS="KEEP"
PRINTL BEFORE_PRINTSL_COUNTED_SKIP
PRINT PREFIX1[
PRINTSL ZZS(1)
PRINTL ]SUFFIX1
PRINTFORML AFTER_FIRST_PRINTSL A={A} B={B} R={RESULT} RS=[%RESULTS%]
SKIPDISP 1
PRINTSL ZZS(9)
SKIPDISP 0
PRINTFORML AFTER_SKIP_PRINTSL A={A} B={B} R={RESULT} RS=[%RESULTS%]
PRINT PREFIX2[
PRINTSL ZZS(2)
PRINTL ]SUFFIX2
PRINTFORML FINAL_PRINTSL A={A} B={B} R={RESULT} RS=[%RESULTS%]
PRINTL DONE_PRINTSL_COUNTED_SKIP
OUTPUTLOG
QUIT
@ZZS(ARG:0)
#FUNCTIONS
A=A*10+ARG:0
RETURNF "left  right"
