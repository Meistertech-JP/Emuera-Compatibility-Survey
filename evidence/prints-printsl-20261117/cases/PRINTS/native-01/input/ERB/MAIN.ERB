@SYSTEM_TITLE
A=0
B=71
RESULT=701
RESULTS="KEEP"
PRINTL BEFORE_PRINTS_COUNTED_SKIP
PRINT PREFIX1[
PRINTS ZZS(1)
PRINTL ]SUFFIX1
PRINTFORML AFTER_FIRST_PRINTS A={A} B={B} R={RESULT} RS=[%RESULTS%]
SKIPDISP 1
PRINTS ZZS(9)
SKIPDISP 0
PRINTFORML AFTER_SKIP_PRINTS A={A} B={B} R={RESULT} RS=[%RESULTS%]
PRINT PREFIX2[
PRINTS ZZS(2)
PRINTL ]SUFFIX2
PRINTFORML FINAL_PRINTS A={A} B={B} R={RESULT} RS=[%RESULTS%]
PRINTL DONE_PRINTS_COUNTED_SKIP
OUTPUTLOG
QUIT
@ZZS(ARG:0)
#FUNCTIONS
A=A*10+ARG:0
RETURNF "left  right"
