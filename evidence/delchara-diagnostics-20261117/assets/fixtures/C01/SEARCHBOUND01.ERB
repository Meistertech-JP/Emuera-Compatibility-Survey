@SYSTEM_TITLE
PRINTL CASE241 delete_empty
A=0
B=0
RESULT=701
TARGET=-1
MASTER=-1
ASSI=-1
PRINTFORML OBS241 BEFORE N={CHARANUM} R={RESULT} A={A} B={B}
PRINTFORML OBS241 BEFORE T={TARGET} M={MASTER} S={ASSI}
FOR LOCAL,0,CHARANUM
PRINTFORML OBS241 BEFORE I={LOCAL} NO={NO:LOCAL} F={CFLAG:LOCAL:1}
PRINTFORML OBS241 BEFORE I={LOCAL} NAME=[%NAME:LOCAL%] CS=[%CSTR:LOCAL:0%]
NEXT
OUTPUTLOG
DELCHARA 0
PRINTFORML OBS241 AFTER N={CHARANUM} R={RESULT} A={A} B={B}
PRINTFORML OBS241 AFTER T={TARGET} M={MASTER} S={ASSI}
FOR LOCAL,0,CHARANUM
PRINTFORML OBS241 AFTER I={LOCAL} NO={NO:LOCAL} F={CFLAG:LOCAL:1}
PRINTFORML OBS241 AFTER I={LOCAL} NAME=[%NAME:LOCAL%] CS=[%CSTR:LOCAL:0%]
NEXT
PRINTL DONE241
OUTPUTLOG
QUIT
