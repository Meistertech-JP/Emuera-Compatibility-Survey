@SYSTEM_TITLE
#DIMS ZZFSARR,4
#DIM ZZFSOUT
PRINTL BEGIN R3_REGEX_ANCHOR
OUTPUTLOG
ZZFSARR:0 = ab
ZZFSARR:1 = a
ZZFSARR:2 = ab
ZZFSARR:3 =
A=0
B=0
RESULT:0=777
RESULTS:0 = FS_STRING_SENTINEL
ZZFSOUT=888
PRINTL BEFORE R3_REGEX_ANCHOR_0
OUTPUTLOG
FINDLASTELEMENT ZZFSARR,ZZFSH0X2(),ZZFSH0X3(),ZZFSH0X4(),ZZFSH0X5()
PRINTFORML AFTER R3_REGEX_ANCHOR_0 R={RESULT:0} SK={RESULTS:0 == "FS_STRING_SENTINEL"} OUT={ZZFSOUT}
PRINTFORML EVAL R3_REGEX_ANCHOR_0 COUNT={A} ORDER={B}
PRINTFORML ARRAY R3_REGEX_ANCHOR_0 [%ZZFSARR:0%|%ZZFSARR:1%|%ZZFSARR:2%|%ZZFSARR:3%]
OUTPUTLOG
PRINTL DONE R3_REGEX_ANCHOR
OUTPUTLOG
QUIT
@ZZFSH0X2
#FUNCTIONS
A+=1
B=B*10+2
PRINTFORML ARG R3_REGEX_ANCHOR_0 SLOT=2 COUNT={A} ORDER={B}
RETURNF "^a"
@ZZFSH0X3
#FUNCTION
A+=1
B=B*10+3
PRINTFORML ARG R3_REGEX_ANCHOR_0 SLOT=3 COUNT={A} ORDER={B}
RETURNF 0
@ZZFSH0X4
#FUNCTION
A+=1
B=B*10+4
PRINTFORML ARG R3_REGEX_ANCHOR_0 SLOT=4 COUNT={A} ORDER={B}
RETURNF 4
@ZZFSH0X5
#FUNCTION
A+=1
B=B*10+5
PRINTFORML ARG R3_REGEX_ANCHOR_0 SLOT=5 COUNT={A} ORDER={B}
RETURNF 0
