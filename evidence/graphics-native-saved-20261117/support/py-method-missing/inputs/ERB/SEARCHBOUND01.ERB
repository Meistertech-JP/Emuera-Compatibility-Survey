RESULT=701
RESULTS '= "sentinel230"
OUTPUTLOG
A=0
PRINTL BEFORE230 1 GWIDTH missing
OUTPUTLOG
GWIDTH QID(230)
B=RESULT
PRINTFORML OBS230 1 missing VALUE={B} RESULT={RESULT} RESULTS=[%RESULTS%] EVAL={A}
OUTPUTLOG
PRINTL DONE230
OUTPUTLOG
QUIT
@QID(ARG)
#FUNCTION
A=A*10+1
RETURNF ARG
@QNAME(ARGS)
#FUNCTIONS
A=A*10+1
RETURNF ARGS
@QX(ARG)
#FUNCTION
A=A*10+2
RETURNF ARG
@QY(ARG)
#FUNCTION
A=A*10+3
RETURNF ARG
