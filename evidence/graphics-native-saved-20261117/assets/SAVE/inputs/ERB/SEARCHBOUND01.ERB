@SYSTEM_TITLE
PRINTL BEGIN232 gsave-expression-positive
OUTPUTLOG
RESULT=701
RESULTS '= "sentinel232"
PRINTL SETUP_CREATE
OUTPUTLOG
B=GCREATEFROMFILE(232,"PIX232.BMP")
PRINTFORML SETUP_CREATE_RET={B}
OUTPUTLOG
IF B != 1
PRINTL SETUP_STOP
OUTPUTLOG
QUIT
ENDIF
PRINTL ENTER_SAVE
OUTPUTLOG
A=0
B=GSAVE(ZZ232ID(232),ZZ232SLOT(232))
PRINTL OBS_SAVE
PRINTFORML RET={B}
PRINTFORML R={RESULT}
PRINTFORML RS=%RESULTS%
PRINTFORML EVAL={A}
PRINTFORML EXISTS={GCREATED(232)}
PRINTFORML W={GWIDTH(232)}
PRINTFORML H={GHEIGHT(232)}
PRINTFORML P00={GGETCOLOR(232,0,0)}
PRINTFORML P32={GGETCOLOR(232,3,2)}
PRINTL END_SAVE
OUTPUTLOG
PRINTL ENTER_NEGATIVE_SLOT
OUTPUTLOG
A=0
B=GSAVE(ZZ232ID(232),ZZ232SLOT(-1))
PRINTL OBS_NEGATIVE_SLOT
PRINTFORML RET={B}
PRINTFORML R={RESULT}
PRINTFORML RS=%RESULTS%
PRINTFORML EVAL={A}
PRINTFORML EXISTS={GCREATED(232)}
PRINTFORML W={GWIDTH(232)}
PRINTFORML H={GHEIGHT(232)}
PRINTFORML P00={GGETCOLOR(232,0,0)}
PRINTFORML P32={GGETCOLOR(232,3,2)}
PRINTL END_NEGATIVE_SLOT
OUTPUTLOG
PRINTL ENTER_OVER_SLOT
OUTPUTLOG
A=0
B=GSAVE(ZZ232ID(232),ZZ232SLOT(2147483648))
PRINTL OBS_OVER_SLOT
PRINTFORML RET={B}
PRINTFORML R={RESULT}
PRINTFORML RS=%RESULTS%
PRINTFORML EVAL={A}
PRINTFORML EXISTS={GCREATED(232)}
PRINTFORML W={GWIDTH(232)}
PRINTFORML H={GHEIGHT(232)}
PRINTFORML P00={GGETCOLOR(232,0,0)}
PRINTFORML P32={GGETCOLOR(232,3,2)}
PRINTL END_OVER_SLOT
OUTPUTLOG
PRINTL DONE232
OUTPUTLOG
QUIT
@ZZ232ID(ARG)
#FUNCTION
A=A*10+1
RETURNF ARG
@ZZ232SLOT(ARG)
#FUNCTION
A=A*10+2
RETURNF ARG
@ZZ232FILE(ARGS)
#FUNCTIONS
A=A*10+2
