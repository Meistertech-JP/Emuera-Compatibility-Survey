@SYSTEM_TITLE
FLAG:8=0
FLAG:9=0
FLAG:4=1
FLAG:5=0
RESULT=777
RESULTS = SENTINEL
STR:0 = UNSET
PRINTFORML CS_BE Q0 I={FLAG:8} F={FLAG:9} R={RESULT} S=[%RESULTS%]
OUTPUTLOG
CSVNICKNAME CS_ID(),CS_FLAG()
STR:0 '= RESULTS
PRINTFORML CS_AF Q0 V=[%STR:0%] I={FLAG:8} F={FLAG:9} R={RESULT} S=[%RESULTS%]
OUTPUTLOG
PRINTL CS_DONE
OUTPUTLOG
QUIT
@CS_ID
#FUNCTION
FLAG:8+=1
PRINTFORML CS_ID I={FLAG:8} F={FLAG:9} R={RESULT} S=[%RESULTS%]
RETURNF 10
@CS_FLAG
#FUNCTION
FLAG:9+=1
PRINTFORML CS_FLAG I={FLAG:8} F={FLAG:9} R={RESULT} S=[%RESULTS%]
RETURNF FLAG:4
