@SYSTEM_TITLE
PRINTL BEGIN
ZZKEY:0=5
ZZKEY:1=2
ZZKEY:2=8
ZZKEY:3=9
A=0
B=0
C=3
D=0
E=0
ZZAEPREFVALUE=-777
ZZAEPSTARTVALUE=-777
ZZAEPENDVALUE=-777
RESULT=777
RESULTS = SENTINEL
PRINTFORML BEFORE SUMARRAY_SINGLETON SIZE={VARSIZE("ZZKEY")} DATA={ZZKEY:0},{ZZKEY:1},{ZZKEY:2},{ZZKEY:3} COUNT={A} ORDER={B} C={C} E={E} RESULT={RESULT} RESULTS=[%RESULTS%]
OUTPUTLOG
SUMARRAY ZZKEY,3,4
PRINTFORML VALUE SUMARRAY_SINGLETON RESULT={RESULT} RESULTS=[%RESULTS%]
PRINTFORML AFTER SUMARRAY_SINGLETON COUNT={A} ORDER={B} REFRET={ZZAEPREFVALUE} STARTRET={ZZAEPSTARTVALUE} ENDRET={ZZAEPENDVALUE} C={C} E={E} DATA={ZZKEY:0},{ZZKEY:1},{ZZKEY:2},{ZZKEY:3} RESULT={RESULT} RESULTS=[%RESULTS%]
PRINTL DONE
OUTPUTLOG
QUIT
