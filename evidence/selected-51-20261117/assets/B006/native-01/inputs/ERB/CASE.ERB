@SYSTEM_TITLE
PRINTL BEGIN
ZZKEY:0=5
ZZKEY:1=2
ZZKEY:2=8
ZZKEY:3=9
A=0
B=0
C=3
D=0
E=0
ZZAEPREFVALUE=-777
ZZAEPSTARTVALUE=-777
ZZAEPENDVALUE=-777
RESULT=777
RESULTS = SENTINEL
PRINTFORML BEFORE MINARRAY_MUTATING_ENDPOINTS SIZE={VARSIZE("ZZKEY")} DATA={ZZKEY:0},{ZZKEY:1},{ZZKEY:2},{ZZKEY:3} COUNT={A} ORDER={B} C={C} E={E} RESULT={RESULT} RESULTS=[%RESULTS%]
OUTPUTLOG
MINARRAY ZZKEY:ZZAEPREF(),ZZAEPSTART(),ZZAEPEND()
PRINTFORML VALUE MINARRAY_MUTATING_ENDPOINTS RESULT={RESULT} RESULTS=[%RESULTS%]
PRINTFORML AFTER MINARRAY_MUTATING_ENDPOINTS COUNT={A} ORDER={B} REFRET={ZZAEPREFVALUE} STARTRET={ZZAEPSTARTVALUE} ENDRET={ZZAEPENDVALUE} C={C} E={E} DATA={ZZKEY:0},{ZZKEY:1},{ZZKEY:2},{ZZKEY:3} RESULT={RESULT} RESULTS=[%RESULTS%]
PRINTL DONE
OUTPUTLOG
QUIT
@ZZAEPREF
#FUNCTION
A+=1
B=B*10+1
C=2
ZZKEY:3=13
ZZAEPREFVALUE=0
PRINTFORML HELPER MINARRAY_MUTATING_ENDPOINTS SLOT=1 RET={ZZAEPREFVALUE} COUNT={A} ORDER={B} C={C} E={E} DATA3={ZZKEY:3} RESULT={RESULT} RESULTS=[%RESULTS%]
RETURNF ZZAEPREFVALUE
@ZZAEPSTART
#FUNCTION
A+=1
B=B*10+2
C+=1
ZZKEY:3+=10
ZZAEPSTARTVALUE=1
PRINTFORML HELPER MINARRAY_MUTATING_ENDPOINTS SLOT=2 RET={ZZAEPSTARTVALUE} COUNT={A} ORDER={B} C={C} E={E} DATA3={ZZKEY:3} RESULT={RESULT} RESULTS=[%RESULTS%]
RETURNF ZZAEPSTARTVALUE
@ZZAEPEND
#FUNCTION
A+=1
B=B*10+3
E=C
ZZAEPENDVALUE=E
PRINTFORML HELPER MINARRAY_MUTATING_ENDPOINTS SLOT=3 RET={ZZAEPENDVALUE} COUNT={A} ORDER={B} C={C} E={E} DATA3={ZZKEY:3} RESULT={RESULT} RESULTS=[%RESULTS%]
RETURNF ZZAEPENDVALUE
