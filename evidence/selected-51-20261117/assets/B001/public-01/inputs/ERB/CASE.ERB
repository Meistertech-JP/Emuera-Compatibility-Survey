@SYSTEM_TITLE
PRINTL BEGIN
ZZKEY:0=5
ZZKEY:1=2
ZZKEY:2=8
ZZKEY:3=9
A=0
B=0
C=3
D=0
E=0
ZZAEPREFVALUE=-777
ZZAEPSTARTVALUE=-777
ZZAEPENDVALUE=-777
RESULT=777
RESULTS = SENTINEL
PRINTFORML BEFORE MAXARRAY_END_OVERRUN SIZE={VARSIZE("ZZKEY")} DATA={ZZKEY:0},{ZZKEY:1},{ZZKEY:2},{ZZKEY:3} COUNT={A} ORDER={B} C={C} E={E} RESULT={RESULT} RESULTS=[%RESULTS%]
OUTPUTLOG
MAXARRAY ZZKEY,0,5
PRINTFORML VALUE MAXARRAY_END_OVERRUN RESULT={RESULT} RESULTS=[%RESULTS%]
PRINTFORML AFTER MAXARRAY_END_OVERRUN COUNT={A} ORDER={B} REFRET={ZZAEPREFVALUE} STARTRET={ZZAEPSTARTVALUE} ENDRET={ZZAEPENDVALUE} C={C} E={E} DATA={ZZKEY:0},{ZZKEY:1},{ZZKEY:2},{ZZKEY:3} RESULT={RESULT} RESULTS=[%RESULTS%]
PRINTL DONE
OUTPUTLOG
QUIT
