@SYSTEM_TITLE
#DIMS ZZUCOUT
STR:4 '= "\\u0041"
STR:5 '= "\\uD800"
STR:6 '= "\\uD83D"
STR:7 '= "\\uDE00"
STR:8 '= "\\uFFFD"
PRINTL BEGIN CHARATU_INDEX_FAULT_EMPTY_EXPR
OUTPUTLOG
A=0
B=0
C=-999
D=-888
RESULT:0=777
RESULTS:0 = SENTINEL
ZZUCOUT = OUT_SENTINEL
PRINTL BEFORE CHARATU_INDEX_FAULT_EMPTY_EXPR_INDEX_FAULT
OUTPUTLOG
ZZUCOUT '= CHARATU(ZZUC0X1(),ZZUC0X2())
PRINTFORML AFTER CHARATU_INDEX_FAULT_EMPTY_EXPR_INDEX_FAULT D={D} R={RESULT:0} SKEEP={RESULTS:0 == "SENTINEL"} SLEN={STRLENSU(RESULTS:0)} N={STRLENSU(ZZUCOUT)} COUNT={A} ORDER={B}
PRINTFORML UNITS CHARATU_INDEX_FAULT_EMPTY_EXPR_INDEX_FAULT A={STRCOUNT(ZZUCOUT,STR:4)} D800={STRCOUNT(ZZUCOUT,STR:5)} HIGH={STRCOUNT(ZZUCOUT,STR:6)} LOW={STRCOUNT(ZZUCOUT,STR:7)} REPL={STRCOUNT(ZZUCOUT,STR:8)}
PRINTFORML RAW CHARATU_INDEX_FAULT_EMPTY_EXPR_INDEX_FAULT OUT=[%ZZUCOUT%] RESULTS=[%RESULTS:0%]
OUTPUTLOG
PRINTL DONE CHARATU_INDEX_FAULT_EMPTY_EXPR
OUTPUTLOG
QUIT
@ZZUC0X1
#FUNCTIONS
A += 1
B = B*10+1
PRINTFORML ARG CHARATU_INDEX_FAULT_EMPTY_EXPR_INDEX_FAULT SLOT=1 COUNT={A} ORDER={B}
RETURNF ""
@ZZUC0X2
#FUNCTION
A += 1
B = B*10+2
PRINTFORML ARG CHARATU_INDEX_FAULT_EMPTY_EXPR_INDEX_FAULT SLOT=2 COUNT={A} ORDER={B}
C=1/0
RETURNF 0
