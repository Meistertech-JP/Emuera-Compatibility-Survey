@SYSTEM_TITLE
A=0
B=0
C=701
E=0
F=0
ZZREVD:0=6
ZZREVD:1=99
LOCALS '= "ab"
ZZREVS '= "ab"
PRINTL REVIEW BEFORE inc-badindex-pre
F=2
C=++ZZREVD:ZZIDX()
PRINTFORML REVIEW AFTER C={C}
PRINTFORML REVIEW STATE A={A} B={B}
PRINTFORML REVIEW STATE D0={ZZREVD:0} D1={ZZREVD:1}
PRINTFORML REVIEW STATE S=[%LOCALS%]
PRINTL REVIEW DONE inc-badindex-pre
OUTPUTLOG
QUIT
@ZZL
#FUNCTION
A=A+1
B=B*10+1
PRINTFORML EVENT LEFT A={A} B={B}
RETURNF E
@ZZR
#FUNCTION
A=A+1
B=B*10+2
PRINTFORML EVENT RIGHT A={A} B={B}
RETURNF F
@ZZBAD
#FUNCTION
A=A+1
PRINTFORML EVENT BAD A={A}
RETURNF 1/E
@ZZIDX
#FUNCTION
A=A+1
PRINTFORML EVENT INDEX A={A}
RETURNF F
@ZZSL
#FUNCTIONS
A=A+1
B=B*10+1
PRINTFORML EVENT STRLEFT A={A} B={B}
RETURNF ZZREVS
@ZZSR
#FUNCTIONS
A=A+1
B=B*10+2
PRINTFORML EVENT STRRIGHT A={A} B={B}
RETURNF ZZREVS
