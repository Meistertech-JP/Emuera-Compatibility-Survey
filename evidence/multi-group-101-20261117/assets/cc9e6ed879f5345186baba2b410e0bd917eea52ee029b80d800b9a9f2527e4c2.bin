@SYSTEM_TITLE
A=2
DEBUGPRINTFORML TRACE_BEFORE_SELECT
SELECTCASE A
CASE 1
DEBUGPRINTFORML TRACE_OUTER_CASE1
PRINTFORML OUTER_BAD
CASE 2
DEBUGPRINTFORML TRACE_OUTER_CASE2
PRINTFORML OUTER_GOOD
SELECTCASE 3
CASE 2
DEBUGPRINTFORML TRACE_INNER_CASE2
PRINTFORML INNER_BAD
CASE 3
DEBUGPRINTFORML TRACE_INNER_CASE3
PRINTFORML INNER_GOOD
CASEELSE
DEBUGPRINTFORML TRACE_INNER_ELSE
PRINTFORML INNER_ELSE
ENDSELECT
DEBUGPRINTFORML TRACE_AFTER_INNER
PRINTFORML AFTER_INNER
CASEELSE
DEBUGPRINTFORML TRACE_OUTER_ELSE
PRINTFORML OUTER_ELSE
ENDSELECT
DEBUGPRINTFORML TRACE_AFTER_SELECT
PRINTFORML AFTER_SELECT
QUIT
