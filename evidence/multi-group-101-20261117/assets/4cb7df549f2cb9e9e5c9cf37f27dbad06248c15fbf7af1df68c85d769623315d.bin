@SYSTEM_TITLE
PRINTL BEGIN230 graphics-method-created
RESULT=701
RESULTS '= "sentinel230"
OUTPUTLOG
B=GCREATE(230,4,3)
OUTPUTLOG
PRINTFORML SETUP230 CREATE={B}
OUTPUTLOG
B=GCLEAR(230,4279312947)
OUTPUTLOG
PRINTFORML SETUP230 CLEAR={B}
OUTPUTLOG
A=0
PRINTL BEFORE230 1 GWIDTH width_created
OUTPUTLOG
GWIDTH QID(230)
B=RESULT
PRINTFORML OBS230 1 width_created VALUE={B} RESULT={RESULT} RESULTS=[%RESULTS%] EVAL={A}
OUTPUTLOG
A=0
PRINTL BEFORE230 2 GHEIGHT height_created
OUTPUTLOG
GHEIGHT QID(230)
B=RESULT
PRINTFORML OBS230 2 height_created VALUE={B} RESULT={RESULT} RESULTS=[%RESULTS%] EVAL={A}
OUTPUTLOG
A=0
PRINTL BEFORE230 3 GGETCOLOR fill_origin
OUTPUTLOG
GGETCOLOR QID(230),QX(0),QY(0)
B=RESULT
PRINTFORML OBS230 3 fill_origin VALUE={B} RESULT={RESULT} RESULTS=[%RESULTS%] EVAL={A}
OUTPUTLOG
A=0
PRINTL BEFORE230 4 GGETCOLOR fill_last
OUTPUTLOG
GGETCOLOR QID(230),QX(3),QY(2)
B=RESULT
PRINTFORML OBS230 4 fill_last VALUE={B} RESULT={RESULT} RESULTS=[%RESULTS%] EVAL={A}
OUTPUTLOG
A=0
PRINTL BEFORE230 5 GGETCOLOR x_negative
OUTPUTLOG
GGETCOLOR QID(230),QX(-1),QY(0)
B=RESULT
PRINTFORML OBS230 5 x_negative VALUE={B} RESULT={RESULT} RESULTS=[%RESULTS%] EVAL={A}
OUTPUTLOG
A=0
PRINTL BEFORE230 6 GGETCOLOR x_equal_width
OUTPUTLOG
GGETCOLOR QID(230),QX(4),QY(0)
B=RESULT
PRINTFORML OBS230 6 x_equal_width VALUE={B} RESULT={RESULT} RESULTS=[%RESULTS%] EVAL={A}
OUTPUTLOG
A=0
PRINTL BEFORE230 7 GGETCOLOR y_equal_height
OUTPUTLOG
GGETCOLOR QID(230),QX(0),QY(3)
B=RESULT
PRINTFORML OBS230 7 y_equal_height VALUE={B} RESULT={RESULT} RESULTS=[%RESULTS%] EVAL={A}
OUTPUTLOG
PRINTL DONE230
OUTPUTLOG
QUIT
@QID(ARG)
#FUNCTION
A=A*10+1
RETURNF ARG
@QNAME(ARGS)
#FUNCTIONS
A=A*10+1
RETURNF ARGS
@QX(ARG)
#FUNCTION
A=A*10+2
RETURNF ARG
@QY(ARG)
#FUNCTION
A=A*10+3
RETURNF ARG
