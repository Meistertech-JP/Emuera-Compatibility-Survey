@SYSTEM_TITLE
PRINTL BEGIN230 sprite-expression-existing
RESULT=701
RESULTS '= "sentinel230"
OUTPUTLOG
A=0
PRINTL BEFORE230 1 SPRITEGETCOLOR sprite_top_left
OUTPUTLOG
B=SPRITEGETCOLOR(QNAME("ZZ230"),QX(0),QY(0))
PRINTFORML OBS230 1 sprite_top_left VALUE={B} RESULT={RESULT} RESULTS=[%RESULTS%] EVAL={A}
OUTPUTLOG
A=0
PRINTL BEFORE230 2 SPRITEGETCOLOR sprite_bottom_right
OUTPUTLOG
B=SPRITEGETCOLOR(QNAME("ZZ230"),QX(3),QY(2))
PRINTFORML OBS230 2 sprite_bottom_right VALUE={B} RESULT={RESULT} RESULTS=[%RESULTS%] EVAL={A}
OUTPUTLOG
A=0
PRINTL BEFORE230 3 SPRITEGETCOLOR sprite_x_negative
OUTPUTLOG
B=SPRITEGETCOLOR(QNAME("ZZ230"),QX(-1),QY(0))
PRINTFORML OBS230 3 sprite_x_negative VALUE={B} RESULT={RESULT} RESULTS=[%RESULTS%] EVAL={A}
OUTPUTLOG
A=0
PRINTL BEFORE230 4 SPRITEGETCOLOR sprite_x_equal_width
OUTPUTLOG
B=SPRITEGETCOLOR(QNAME("ZZ230"),QX(4),QY(0))
PRINTFORML OBS230 4 sprite_x_equal_width VALUE={B} RESULT={RESULT} RESULTS=[%RESULTS%] EVAL={A}
OUTPUTLOG
A=0
PRINTL BEFORE230 5 SPRITEGETCOLOR sprite_y_equal_height
OUTPUTLOG
B=SPRITEGETCOLOR(QNAME("ZZ230"),QX(0),QY(3))
PRINTFORML OBS230 5 sprite_y_equal_height VALUE={B} RESULT={RESULT} RESULTS=[%RESULTS%] EVAL={A}
OUTPUTLOG
PRINTL DONE230
OUTPUTLOG
QUIT
@QID(ARG)
#FUNCTION
A=A*10+1
RETURNF ARG
@QNAME(ARGS)
#FUNCTIONS
A=A*10+1
RETURNF ARGS
@QX(ARG)
#FUNCTION
A=A*10+2
RETURNF ARG
@QY(ARG)
#FUNCTION
A=A*10+3
RETURNF ARG
