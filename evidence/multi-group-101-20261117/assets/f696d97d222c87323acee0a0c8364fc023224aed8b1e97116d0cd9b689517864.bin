@SYSTEM_TITLE
PRINTL BEGIN_gsetpen-expr-missing
OUTPUTLOG
RESULT = 701
RESULTS = "sentinel233"
FLAG:233 = 0
PRINTL BEFORE_MISSING
OUTPUTLOG
LOCAL = GSETPEN(MARK(1,233),MARK(2,-1))
PRINTFORML OBS_MISSING={LOCAL}|{RESULT}|%RESULTS%|{FLAG:233}
PRINTL ENDOBS
OUTPUTLOG
RESULT = 701
RESULTS = "sentinel233"
FLAG:233 = 0
PRINTL BEFORE_MISSING_REPEAT
OUTPUTLOG
LOCAL = GSETPEN(MARK(1,233),MARK(2,-1))
PRINTFORML OBS_MISSING_REPEAT={LOCAL}|{RESULT}|%RESULTS%|{FLAG:233}
PRINTL ENDOBS
OUTPUTLOG
PRINTFORML OBS_STATE_FINAL={GCREATED(233)},{GWIDTH(233)},{GHEIGHT(233)}
PRINTL ENDOBS
OUTPUTLOG
PRINTL DONE
OUTPUTLOG
QUIT
@MARK(ARG,ARG:1)
#FUNCTION
FLAG:233 = FLAG:233 * 10 + ARG
RETURNF ARG:1
