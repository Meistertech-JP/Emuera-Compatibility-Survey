PRINTFORML STATE_AFTER_SKIP=A{A};TARGET{TARGET};ABL{ABL:0:1},{ABL:1:1},{ABL:1:2},{ABL:1:3};ITEM{ITEM:1},{ITEM:2},{ITEM:3};PRICE{ITEMPRICE:0},{ITEMPRICE:1},{ITEMPRICE:2}
