@SYSTEM_TITLE
PRINTL BEGIN230 ggetcolor-expression-missing
RESULT=701
RESULTS '= "sentinel230"
OUTPUTLOG
A=0
PRINTL BEFORE230 1 GGETCOLOR missing
OUTPUTLOG
B=GGETCOLOR(QID(230),QX(1),QY(2))
PRINTFORML OBS230 1 missing VALUE={B} RESULT={RESULT} RESULTS=[%RESULTS%] EVAL={A}
OUTPUTLOG
PRINTL DONE230
OUTPUTLOG
QUIT
@QID(ARG)
#FUNCTION
A=A*10+1
RETURNF ARG
@QNAME(ARGS)
#FUNCTIONS
A=A*10+1
RETURNF ARGS
@QX(ARG)
#FUNCTION
A=A*10+2
RETURNF ARG
@QY(ARG)
#FUNCTION
A=A*10+3
RETURNF ARG
