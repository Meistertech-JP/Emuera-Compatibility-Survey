@SYSTEM_TITLE
PRINTL BEGIN_gsetfont-method-missing
OUTPUTLOG
RESULT = 701
RESULTS = "sentinel233"
FLAG:233 = 0
PRINTL BEFORE_MISSING
OUTPUTLOG
GSETFONT MARK(1,233),"Arial",MARK(2,-1)
LOCAL = RESULT
PRINTFORML OBS_MISSING={LOCAL}|{RESULT}|%RESULTS%|{FLAG:233}
PRINTL ENDOBS
OUTPUTLOG
RESULT = 701
RESULTS = "sentinel233"
FLAG:233 = 0
PRINTL BEFORE_MISSING_REPEAT
OUTPUTLOG
GSETFONT MARK(1,233),"Arial",MARK(2,-1)
LOCAL = RESULT
PRINTFORML OBS_MISSING_REPEAT={LOCAL}|{RESULT}|%RESULTS%|{FLAG:233}
PRINTL ENDOBS
OUTPUTLOG
PRINTFORML OBS_STATE_FINAL={GCREATED(233)},{GWIDTH(233)},{GHEIGHT(233)}
PRINTL ENDOBS
OUTPUTLOG
PRINTL DONE
OUTPUTLOG
QUIT
@MARK(ARG,ARG:1)
#FUNCTION
FLAG:233 = FLAG:233 * 10 + ARG
RETURNF ARG:1
