@SYSTEM_TITLE
PRINTL BEGIN234
RESULT=701
RESULTS '= "sent234"
OUTPUTLOG
A=0
PRINTL B234 1 empty_name
OUTPUTLOG
B=SPRITEANIMEADDFRAME(QS("",1),QN(234,2),QN(0,3),QN(0,4),QN(4,5),QN(3,6),QN(0,7),QN(0,8),QN(100,9))
PRINTL O234 1
PRINTFORML V={B}
PRINTFORML R={RESULT}
PRINTFORML S=%RESULTS%
PRINTFORML E={A}
PRINTL ENDOBS234
OUTPUTLOG
PRINTL DONE234
OUTPUTLOG
QUIT
@QN(ARG,ARG:1)
#FUNCTION
A=A*10+ARG:1
RETURNF ARG
@QS(ARGS,ARG)
#FUNCTIONS
A=A*10+ARG
RETURNF ARGS
