@SYSTEM_TITLE
PRINTL BEGIN234
RESULT=701
RESULTS '= "sent234"
OUTPUTLOG
A=0
PRINTL B234 1 valid_no_setup
OUTPUTLOG
B=SPRITEANIMECREATE(QS("DIRECT234",1),QN(4,2),QN(3,3))
PRINTL O234 1
PRINTFORML V={B}
PRINTFORML R={RESULT}
PRINTFORML S=%RESULTS%
PRINTFORML E={A}
PRINTL ENDOBS234
OUTPUTLOG
A=0
PRINTL B234 2 created
OUTPUTLOG
B=SPRITECREATED("DIRECT234")
PRINTL O234 2
PRINTFORML V={B}
PRINTFORML R={RESULT}
PRINTFORML S=%RESULTS%
PRINTFORML E={A}
PRINTL ENDOBS234
OUTPUTLOG
A=0
PRINTL B234 3 width
OUTPUTLOG
B=SPRITEWIDTH("DIRECT234")
PRINTL O234 3
PRINTFORML V={B}
PRINTFORML R={RESULT}
PRINTFORML S=%RESULTS%
PRINTFORML E={A}
PRINTL ENDOBS234
OUTPUTLOG
A=0
PRINTL B234 4 height
OUTPUTLOG
B=SPRITEHEIGHT("DIRECT234")
PRINTL O234 4
PRINTFORML V={B}
PRINTFORML R={RESULT}
PRINTFORML S=%RESULTS%
PRINTFORML E={A}
PRINTL ENDOBS234
OUTPUTLOG
A=0
PRINTL B234 5 repeat
OUTPUTLOG
B=SPRITEANIMECREATE(QS("DIRECT234",1),QN(5,2),QN(6,3))
PRINTL O234 5
PRINTFORML V={B}
PRINTFORML R={RESULT}
PRINTFORML S=%RESULTS%
PRINTFORML E={A}
PRINTL ENDOBS234
OUTPUTLOG
PRINTL DONE234
OUTPUTLOG
QUIT
@QN(ARG,ARG:1)
#FUNCTION
A=A*10+ARG:1
RETURNF ARG
@QS(ARGS,ARG)
#FUNCTIONS
A=A*10+ARG
RETURNF ARGS
