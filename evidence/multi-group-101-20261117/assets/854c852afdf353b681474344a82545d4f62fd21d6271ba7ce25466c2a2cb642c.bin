@SYSTEM_TITLE
PRINTL BEGIN_gsetfont-method-positive
OUTPUTLOG
PRINTL BEFORE_GCREATE
OUTPUTLOG
LOCAL = GCREATE(233,4,3)
PRINTFORML OBS_CREATE={LOCAL}
PRINTL ENDOBS
OUTPUTLOG
PRINTFORML OBS_STATE_BEFORE={GCREATED(233)},{GWIDTH(233)},{GHEIGHT(233)}
PRINTL ENDOBS
OUTPUTLOG
PRINTFORML OBS_PIX_BEFORE={GGETCOLOR(233,0,0)},{GGETCOLOR(233,1,1)},{GGETCOLOR(233,2,1)},{GGETCOLOR(233,3,2)}
PRINTL ENDOBS
OUTPUTLOG
RESULT = 701
RESULTS = "sentinel233"
FLAG:233 = 0
PRINTL BEFORE_SET_FONT
OUTPUTLOG
GSETFONT MARK(1,233),"Arial",MARK(2,12)
LOCAL = RESULT
PRINTFORML OBS_SET_FONT={LOCAL}|{RESULT}|%RESULTS%|{FLAG:233}
PRINTL ENDOBS
OUTPUTLOG
PRINTFORML OBS_PIX_AFTER_FONT={GGETCOLOR(233,0,0)},{GGETCOLOR(233,1,1)},{GGETCOLOR(233,2,1)},{GGETCOLOR(233,3,2)}
PRINTL ENDOBS
OUTPUTLOG
RESULT = 701
RESULTS = "sentinel233"
FLAG:233 = 0
PRINTL BEFORE_REPLACE_FONT
OUTPUTLOG
GSETFONT 233,"Arial",18
LOCAL = RESULT
PRINTFORML OBS_REPLACE_FONT={LOCAL}|{RESULT}|%RESULTS%|{FLAG:233}
PRINTL ENDOBS
OUTPUTLOG
RESULT = 701
RESULTS = "sentinel233"
FLAG:233 = 0
PRINTL BEFORE_SIZE_ZERO
OUTPUTLOG
GSETFONT 233,"Arial",0
LOCAL = RESULT
PRINTFORML OBS_SIZE_ZERO={LOCAL}|{RESULT}|%RESULTS%|{FLAG:233}
PRINTL ENDOBS
OUTPUTLOG
RESULT = 701
RESULTS = "sentinel233"
FLAG:233 = 0
PRINTL BEFORE_SIZE_NEG
OUTPUTLOG
GSETFONT 233,"Arial",-1
LOCAL = RESULT
PRINTFORML OBS_SIZE_NEG={LOCAL}|{RESULT}|%RESULTS%|{FLAG:233}
PRINTL ENDOBS
OUTPUTLOG
PRINTFORML OBS_PIX_AFTER_FONT_BOUNDS={GGETCOLOR(233,0,0)},{GGETCOLOR(233,1,1)},{GGETCOLOR(233,2,1)},{GGETCOLOR(233,3,2)}
PRINTL ENDOBS
OUTPUTLOG
PRINTFORML OBS_STATE_FINAL={GCREATED(233)},{GWIDTH(233)},{GHEIGHT(233)}
PRINTL ENDOBS
OUTPUTLOG
PRINTL DONE
OUTPUTLOG
QUIT
@MARK(ARG,ARG:1)
#FUNCTION
FLAG:233 = FLAG:233 * 10 + ARG
RETURNF ARG:1
