@SYSTEM_TITLE
A=0
B=0
E=0
RESULT=701
RESULTS="KEEP"
PRINTL BEFORE
OUTPUTLOG
CALLEVENT EVENTTRAIN
PRINTFORML AFTER A={A} B={B} E={E} R={RESULT} S=%RESULTS%
PRINTL DONE
OUTPUTLOG
QUIT

@EVENTTRAIN
#PRI
#SINGLE
A=A*10+1
RETURN 1
@EVENTTRAIN
#PRI
A=A*10+2
RETURN 0
@EVENTTRAIN
A=A*10+3
RETURN 0
@EVENTTRAIN
#LATER
A=A*10+4
RETURN 0
