@SYSTEM_TITLE
A=0
B=0
E=0
RESULT=701
RESULTS="KEEP"
PRINTL BEFORE
OUTPUTLOG
JUMP RCALLEE,RARG(),1/(E-E)
PRINTFORML AFTER A={A} B={B} E={E} R={RESULT} S=%RESULTS%
PRINTL DONE
OUTPUTLOG
QUIT

@RARG
#FUNCTION
A+=1
B=B*10+1
PRINTFORML ARG A={A} B={B}
RETURNF 7

@RCALLEE(ARG,ARG:1=9)
E+=1
PRINTFORML BODY X={ARG} Y={ARG:1}
OUTPUTLOG
RETURN 55
