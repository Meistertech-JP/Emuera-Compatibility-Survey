@SYSTEM_TITLE
A=0
B=0
E=0
RESULT=701
RESULTS="KEEP"
PRINTL BEFORE
OUTPUTLOG
CALLFORM %RNAME()%,RARG()
PRINTFORML AFTER A={A} B={B} E={E} R={RESULT} S=%RESULTS%
PRINTL DONE
OUTPUTLOG
QUIT

@RARG
#FUNCTION
A+=1
B=B*10+1
PRINTFORML ARG A={A} B={B}
RETURNF 7

@RNAME
#FUNCTIONS
A+=1
B=B*10+2
RETURNF "RCALLEE"

@RCALLEE(ARG)
E+=1
PRINTFORML BODY_ENTER A={A} B={B} E={E}
OUTPUTLOG
C=1/(E-E)
RETURN 55
