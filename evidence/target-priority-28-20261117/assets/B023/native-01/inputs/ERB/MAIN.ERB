@SYSTEM_TITLE
SKIPDISP 0
FORCEKANA 0
FONTSTYLE 0
SETCOLOR 65280
A=0
C=0
B=71
RESULT=701
RESULTS '= "KEEP"
PRINTL BEGIN_PRINTFORMSDL
PRINTSL "CONTROL_BEFORE"
STR:0 '= HTML_GETPRINTEDSTR(0)
PRINTFORMSDL ZZD_TEXT(1)
STR:1 '= HTML_GETPRINTEDSTR(0)
PRINTFORML NORMAL_PRINTFORMSDL A={A} C={C} B={B} R={RESULT} RS=[%RESULTS%]
SKIPDISP 1
PRINTFORMSDL ZZD_TEXT(9)
SKIPDISP 0
PRINTFORML SKIP_PRINTFORMSDL A={A} C={C} B={B} R={RESULT} RS=[%RESULTS%]
PRINTSL "CONTROL_AFTER"
STR:2 '= HTML_GETPRINTEDSTR(0)
PRINTL HTML_CONTROL_BEFORE_PRINTFORMSDL
PRINTFORML %STR:0%
PRINTL HTML_TARGET_PRINTFORMSDL
PRINTFORML %STR:1%
PRINTL HTML_CONTROL_AFTER_PRINTFORMSDL
PRINTFORML %STR:2%
PRINTL DONE_PRINTFORMSDL
OUTPUTLOG
QUIT
@ZZD_TEXT(ARG:0)
#FUNCTIONS
C=C*10+ARG:0
RETURNF "X={ZZD_NUM(1)}  Y=%ZZD_STR(2)%"
@ZZD_NUM(ARG:0)
#FUNCTION
A=A*10+ARG:0
RETURNF ARG:0+10
@ZZD_STR(ARG:0)
#FUNCTIONS
A=A*10+ARG:0
RETURNF "left  right"
