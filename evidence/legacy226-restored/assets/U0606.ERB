@SYSTEM_TITLE
PRINTL CASE ADDCHARA
PRINTFORML B N={CHARANUM}
ADDCHARA 0,10,20
PRINTFORML A N={CHARANUM}
PRINTFORML A I=0 NO={NO:0}
PRINTFORML A I=0 NAME=[%NAME:0%]
PRINTFORML A I=0 F1={CFLAG:0:1}
PRINTFORML A I=1 NO={NO:1}
