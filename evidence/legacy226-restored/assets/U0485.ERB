@SYSTEM_TITLE
PRINTL CASE241 copy_invalid_destination
ADDCHARA 0,10,20
CFLAG:0:1=101
CFLAG:1:1=202
CFLAG:2:1=303
CSTR:0:0=SRC
CSTR:1:0=MID
CSTR:2:0=DST
TARGET=2
MASTER=1
ASSI=0
A=0
B=0
RESULT=701
PRINTFORML OBS241 BEFORE N={CHARANUM} R={RESULT} A={A} B={B}
PRINTFORML OBS241 BEFORE T={TARGET} M={MASTER} S={ASSI}
FOR LOCAL,0,CHARANUM
PRINTFORML OBS241 BEFORE I={LOCAL} NO={NO:LOCAL} F={CFLAG:LOCAL:1}
PRINTFORML OBS241 BEFORE I={LOCAL} NAME=[%NAME:LOCAL%] CS=[%CSTR:LOCAL:0%]
NEXT
OUTPUTLOG
COPYCHARA H241A(),H241B()
PRINTFORML OBS241 AFTER N={CHARANUM} R={RESULT} A={A} B={B}
PRINTFORML OBS241 AFTER T={TARGET} M={MASTER} S={ASSI}
FOR LOCAL,0,CHARANUM
PRINTFORML OBS241 AFTER I={LOCAL} NO={NO:LOCAL} F={CFLAG:LOCAL:1}
PRINTFORML OBS241 AFTER I={LOCAL} NAME=[%NAME:LOCAL%] CS=[%CSTR:LOCAL:0%]
NEXT
PRINTL DONE241
OUTPUTLOG
QUIT
@H241A
#FUNCTION
A+=1
B=B*10+1
PRINTFORML OBS241 H1 N={CHARANUM} R={RESULT} A={A} B={B}
PRINTFORML OBS241 H1 T={TARGET} M={MASTER} S={ASSI}
FOR LOCAL,0,CHARANUM
PRINTFORML OBS241 H1 I={LOCAL} NO={NO:LOCAL} F={CFLAG:LOCAL:1}
PRINTFORML OBS241 H1 I={LOCAL} NAME=[%NAME:LOCAL%] CS=[%CSTR:LOCAL:0%]
NEXT
OUTPUTLOG
RETURNF 0
@H241B
#FUNCTION
A+=1
B=B*10+2
PRINTFORML OBS241 H2 N={CHARANUM} R={RESULT} A={A} B={B}
PRINTFORML OBS241 H2 T={TARGET} M={MASTER} S={ASSI}
FOR LOCAL,0,CHARANUM
PRINTFORML OBS241 H2 I={LOCAL} NO={NO:LOCAL} F={CFLAG:LOCAL:1}
PRINTFORML OBS241 H2 I={LOCAL} NAME=[%NAME:LOCAL%] CS=[%CSTR:LOCAL:0%]
NEXT
OUTPUTLOG
RETURNF CHARANUM
