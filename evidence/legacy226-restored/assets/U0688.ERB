@SYSTEM_TITLE
ZZ269_C1 = 0
ZZ269_C2 = 0
ZZ269_C3 = 0
ZZ269_ORDER = 0
ZZ269_ZERO = 0
ZZ269_RET2 = 1
ZZ269_DEST = 79
PRINTL ZZ269_P1_BEFORE=1
OUTPUTLOG
IF ZZ269_FIRST()
    ZZ269_DEST = 11
ELSEIF ZZ269_SECOND()
    ZZ269_DEST = 22
ELSEIF ZZ269_BAD()
    ZZ269_DEST = 33
ELSE
    ZZ269_DEST = 44
ENDIF
PRINTFORML ZZ269_P1_DEST={ZZ269_DEST}
PRINTFORML ZZ269_P1_C1={ZZ269_C1}
PRINTFORML ZZ269_P1_C2={ZZ269_C2}
PRINTFORML ZZ269_P1_C3={ZZ269_C3}
PRINTFORML ZZ269_P1_ORDER={ZZ269_ORDER}
PRINTL ZZ269_P1_AFTER=1
OUTPUTLOG
ZZ269_C1 = 0
ZZ269_C2 = 0
ZZ269_C3 = 0
ZZ269_ORDER = 0
ZZ269_RET2 = 0
ZZ269_RET3 = 0
ZZ269_DEST = 79
PRINTL ZZ269_P2_BEFORE=1
OUTPUTLOG
IF ZZ269_FIRST()
    ZZ269_DEST = 11
ELSEIF ZZ269_SECOND()
    ZZ269_DEST = 22
ELSEIF ZZ269_THIRD()
    ZZ269_DEST = 33
ENDIF
PRINTFORML ZZ269_P2_DEST={ZZ269_DEST}
PRINTFORML ZZ269_P2_C1={ZZ269_C1}
PRINTFORML ZZ269_P2_C2={ZZ269_C2}
PRINTFORML ZZ269_P2_C3={ZZ269_C3}
PRINTFORML ZZ269_P2_ORDER={ZZ269_ORDER}
PRINTL ZZ269_P2_AFTER=1
OUTPUTLOG
QUIT

@ZZ269_FIRST
#FUNCTION
ZZ269_C1 += 1
ZZ269_ORDER = ZZ269_ORDER * 10 + 1
RETURNF 0

@ZZ269_SECOND
#FUNCTION
ZZ269_C2 += 1
ZZ269_ORDER = ZZ269_ORDER * 10 + 2
RETURNF ZZ269_RET2

@ZZ269_BAD
#FUNCTION
ZZ269_C3 += 1
ZZ269_ORDER = ZZ269_ORDER * 10 + 3
RETURNF 1 / ZZ269_ZERO

@ZZ269_THIRD
#FUNCTION
ZZ269_C3 += 1
ZZ269_ORDER = ZZ269_ORDER * 10 + 3
RETURNF ZZ269_RET3
