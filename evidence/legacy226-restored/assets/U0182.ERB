@SYSTEM_TITLE
ADDCHARA 0
TARGET = 0
MASTER = 0
A = 2
E = 0
N = 0
S = 0
H = 0
RESULT = 701
PRINTL CASE220_START
BEGIN TRAIN
PRINTL UNREACHED_TITLE
QUIT

@COUNTARG()
#FUNCTION
E += 1
RETURNF A

@PICK()
#FUNCTION
E += 1
RETURNF A - 1

@TRACE
B = ISSKIP()
NOSKIP
PRINTFORML T|%ARGS%|N={N}|S={S}|H={H}|E={E}|SEL={SELECTCOM}|P={PREVCOM}|NEXT={NEXTCOM}|R={RESULT}|SKIP={B}|UP={UP:0}|DOWN={DOWN:0}|CUP={CUP:0:0}|NOW={NOWEX:0:0}|SRC={SOURCE:0:0}
ENDNOSKIP
RETURN 0

@FINISH
SKIPDISP 0
PRINTL CASE220_DONE
OUTPUTLOG
QUIT

@EVENTTRAIN
CALL TRACE("EVENTTRAIN")
SELECTCOM:0 = 99
SELECTCOM:1 = 0
SELECTCOM:2 = 1
IF 8 <= 3
 CALLTRAIN COUNTARG()
 SELECTCOM:1 = 1
 SELECTCOM:2 = 0
 CALL TRACE("AFTER_CALLTRAIN")
ELSEIF 8 == 4
 STOPCALLTRAIN
 CALL TRACE("STOP_INACTIVE")
 DOTRAIN PICK()
 PRINTL UNREACHED_DOT_EVENTTRAIN
ELSEIF 8 == 5
 DOTRAIN PICK()
 PRINTL UNREACHED_DOT_EVENTTRAIN
ELSEIF 8 == 8
 DOTRAIN 0
 PRINTL UNREACHED_DOT_EVENTTRAIN
ENDIF
RETURN 0

@SHOW_STATUS
S += 1
CALL TRACE("SHOW_STATUS")
PRINTL ORDINARY_STATUS
IF S > 4
 PRINTL GUARD_LIMIT
 CALL FINISH
ENDIF
IF 8 == 6
 UP:0 = 81
 DOWN:0 = 82
 CUP:0:0 = 83
 NOWEX:0:0 = 84
 SOURCE:0:0 = 85
 DOTRAIN PICK()
 PRINTL UNREACHED_DOT_STATUS
ENDIF
RETURN 0

@COM_ABLE0
RETURN 1

@COM_ABLE1
IF 8 == 2
 RETURN 0
ENDIF
RETURN 1

@SHOW_USERCOM
CALL TRACE("SHOW_USERCOM")
PRINTL ORDINARY_USERCOM
IF 8 == 7
 UP:0 = 81
 DOWN:0 = 82
 CUP:0:0 = 83
 NOWEX:0:0 = 84
 SOURCE:0:0 = 85
 DOTRAIN PICK()
 PRINTL UNREACHED_DOT_USERCOM
ENDIF
IF 8 <= 3
 UP:0 = 81
 DOWN:0 = 82
 CUP:0:0 = 83
 NOWEX:0:0 = 84
 SOURCE:0:0 = 85
ENDIF
RETURN 0

@EVENTCOM
CALL TRACE("EVENTCOM")
RETURN 0

@COM0
N += 1
CALL TRACE("COM0")
IF 8 == 3
 STOPCALLTRAIN
 CALL TRACE("STOP_RESUMED")
 CALL FINISH
ENDIF
IF 8 == 8
 SOURCE:0:0 = 91
 RETURN 1
ENDIF
RETURN 0

@COM1
N += 1
CALL TRACE("COM1")
IF 8 >= 4
 CALL FINISH
ENDIF
RETURN 0

@USERCOM
N += 1
CALL TRACE("USERCOM")
RETURN 0

@SOURCE_CHECK
CALL TRACE("SOURCE_CHECK")
RETURN 0

@EVENTCOMEND
CALL TRACE("EVENTCOMEND")
IF 8 == 8
 UP:0 = 81
 DOWN:0 = 82
 CUP:0:0 = 83
 NOWEX:0:0 = 84
 SOURCE:0:0 = 85
 DOTRAIN PICK()
 PRINTL UNREACHED_DOT_COMEND
ENDIF
CALL FINISH

@CALLTRAINEND
H += 1
CALL TRACE("CALLTRAINEND")
IF 8 <= 2
 CALL FINISH
ENDIF
RETURN 0
