@SYSTEM_TITLE
#DIM SORTKEY,4
#DIMS SORTNAME,4
SORTKEY:0 = 3
SORTKEY:1 = 1
SORTKEY:2 = 2
SORTKEY:3 = 0
SORTNAME:0 '= "c"
SORTNAME:1 '= "a"
SORTNAME:2 '= "b"
SORTNAME:3 '= "z"
PRINTFORML RESULT={ARRAYMSORT(SORTKEY,SORTNAME)}
PRINTFORML KEYS={SORTKEY:0},{SORTKEY:1},{SORTKEY:2},{SORTKEY:3}
PRINTFORML NAMES=%SORTNAME:0%,%SORTNAME:1%,%SORTNAME:2%,%SORTNAME:3%
PRINTL DONE
OUTPUTLOG
INPUT
QUIT
