@SYSTEM_TITLE
#DIM ZZFNARR,4
#DIM ZZFNOUT
#DIM ZZFNSENT
PRINTL BEGIN N4_EMPTY_R3
OUTPUTLOG
ZZFNARR:0=1
ZZFNARR:1=2
ZZFNARR:2=1
ZZFNARR:3=0
ZZFNOUT=888
ZZFNSENT=999
RESULT:0=777
RESULT:1=776
RESULTS:0 = FN_NUMERIC_SENTINEL
A=0
B=0
PRINTFORML INIT N4_EMPTY_R3_R3 SIZE={VARSIZE("ZZFNARR")} DATA={ZZFNARR:0},{ZZFNARR:1},{ZZFNARR:2},{ZZFNARR:3} REF0={ZZFNARR:0} R={RESULT:0} R1={RESULT:1} SK={RESULTS:0 == "FN_NUMERIC_SENTINEL"} OUT={ZZFNOUT} SENT={ZZFNSENT}
PRINTL BEFORE N4_EMPTY_R3_R3
OUTPUTLOG
FINDLASTELEMENT ZZFNARR:ZZFNH3X1(),ZZFNH3X2(),ZZFNH3X3(),ZZFNH3X4(),ZZFNH3X5()
PRINTFORML AFTER N4_EMPTY_R3_R3 OUT={ZZFNOUT} R={RESULT:0} R1={RESULT:1} SK={RESULTS:0 == "FN_NUMERIC_SENTINEL"} SENT={ZZFNSENT}
PRINTFORML ARRAY N4_EMPTY_R3_R3 SIZE={VARSIZE("ZZFNARR")} DATA={ZZFNARR:0},{ZZFNARR:1},{ZZFNARR:2},{ZZFNARR:3} REF0={ZZFNARR:0}
PRINTFORML EVAL N4_EMPTY_R3_R3 COUNT={A} ORDER={B}
PRINTL FOLLOW N4_EMPTY_R3_R3
OUTPUTLOG
PRINTL DONE N4_EMPTY_R3
OUTPUTLOG
QUIT
@ZZFNH3X1
#FUNCTION
A+=1
B=B*10+1
PRINTFORML ARG N4_EMPTY_R3_R3 SLOT=1 VALUE=0 COUNT={A} ORDER={B}
RETURNF 0
@ZZFNH3X2
#FUNCTION
A+=1
B=B*10+2
PRINTFORML ARG N4_EMPTY_R3_R3 SLOT=2 VALUE=1 COUNT={A} ORDER={B}
RETURNF 1
@ZZFNH3X3
#FUNCTION
A+=1
B=B*10+3
PRINTFORML ARG N4_EMPTY_R3_R3 SLOT=3 VALUE=2 COUNT={A} ORDER={B}
RETURNF 2
@ZZFNH3X4
#FUNCTION
A+=1
B=B*10+4
PRINTFORML ARG N4_EMPTY_R3_R3 SLOT=4 VALUE=2 COUNT={A} ORDER={B}
RETURNF 2
@ZZFNH3X5
#FUNCTION
A+=1
B=B*10+5
PRINTFORML ARG N4_EMPTY_R3_R3 SLOT=5 VALUE=1 COUNT={A} ORDER={B}
RETURNF 1
