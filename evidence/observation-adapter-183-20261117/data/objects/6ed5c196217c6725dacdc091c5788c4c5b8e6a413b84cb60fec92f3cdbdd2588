@SYSTEM_TITLE
#DIM ZZFNARR,4
#DIM ZZFNOUT
#DIM ZZFNSENT
PRINTL BEGIN N4_REVERSE_R1
OUTPUTLOG
ZZFNARR:0=1
ZZFNARR:1=2
ZZFNARR:2=1
ZZFNARR:3=0
ZZFNOUT=888
ZZFNSENT=999
RESULT:0=777
RESULT:1=776
RESULTS:0 = FN_NUMERIC_SENTINEL
A=0
B=0
PRINTFORML INIT N4_REVERSE_R1_R1 SIZE={VARSIZE("ZZFNARR")} DATA={ZZFNARR:0},{ZZFNARR:1},{ZZFNARR:2},{ZZFNARR:3} REF0={ZZFNARR:0} R={RESULT:0} R1={RESULT:1} SK={RESULTS:0 == "FN_NUMERIC_SENTINEL"} OUT={ZZFNOUT} SENT={ZZFNSENT}
PRINTL BEFORE N4_REVERSE_R1_R1
OUTPUTLOG
FINDELEMENT ZZFNARR:ZZFNH1X1(),ZZFNH1X2(),ZZFNH1X3(),ZZFNH1X4(),ZZFNH1X5()
PRINTFORML AFTER N4_REVERSE_R1_R1 OUT={ZZFNOUT} R={RESULT:0} R1={RESULT:1} SK={RESULTS:0 == "FN_NUMERIC_SENTINEL"} SENT={ZZFNSENT}
PRINTFORML ARRAY N4_REVERSE_R1_R1 SIZE={VARSIZE("ZZFNARR")} DATA={ZZFNARR:0},{ZZFNARR:1},{ZZFNARR:2},{ZZFNARR:3} REF0={ZZFNARR:0}
PRINTFORML EVAL N4_REVERSE_R1_R1 COUNT={A} ORDER={B}
PRINTL FOLLOW N4_REVERSE_R1_R1
OUTPUTLOG
PRINTL DONE N4_REVERSE_R1
OUTPUTLOG
QUIT
@ZZFNH1X1
#FUNCTION
A+=1
B=B*10+1
PRINTFORML ARG N4_REVERSE_R1_R1 SLOT=1 VALUE=0 COUNT={A} ORDER={B}
RETURNF 0
@ZZFNH1X2
#FUNCTION
A+=1
B=B*10+2
PRINTFORML ARG N4_REVERSE_R1_R1 SLOT=2 VALUE=1 COUNT={A} ORDER={B}
RETURNF 1
@ZZFNH1X3
#FUNCTION
A+=1
B=B*10+3
PRINTFORML ARG N4_REVERSE_R1_R1 SLOT=3 VALUE=3 COUNT={A} ORDER={B}
RETURNF 3
@ZZFNH1X4
#FUNCTION
A+=1
B=B*10+4
PRINTFORML ARG N4_REVERSE_R1_R1 SLOT=4 VALUE=1 COUNT={A} ORDER={B}
RETURNF 1
@ZZFNH1X5
#FUNCTION
A+=1
B=B*10+5
PRINTFORML ARG N4_REVERSE_R1_R1 SLOT=5 VALUE=1 COUNT={A} ORDER={B}
RETURNF 1
