@SYSTEM_TITLE
#DIMS ZZBHOUT
PRINTL BEGIN B_MAX0_M
OUTPUTLOG
A=0
B=0
RESULT:0=777
RESULTS:0 = SENTINEL
ZZBHOUT = OUT_SENTINEL
