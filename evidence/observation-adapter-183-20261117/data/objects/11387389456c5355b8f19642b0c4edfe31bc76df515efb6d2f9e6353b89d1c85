@SYSTEM_TITLE
#DIMS ZZBHOUT
PRINTL BEGIN B_LENNEG_E
OUTPUTLOG
A=0
B=0
RESULT:0=777
RESULTS:0 = SENTINEL
ZZBHOUT = OUT_SENTINEL
PRINTL BEFORE B_LENNEG_E
OUTPUTLOG
ZZBHOUT '= BARSTR(ZZBH0X1(),ZZBH0X2(),ZZBH0X3())
PRINTFORML AFTER B_LENNEG_E R={RESULT:0} SK={RESULTS:0 == "SENTINEL"} OK={ZZBHOUT == "OUT_SENTINEL"} ON={STRLENSU(ZZBHOUT)} SN={STRLENSU(RESULTS:0)}
PRINTFORML EVAL B_LENNEG_E COUNT={A} ORDER={B}
PRINTFORML VALUE B_LENNEG_E OUT=[%ZZBHOUT%] STR=[%RESULTS:0%]
OUTPUTLOG
PRINTL DONE B_LENNEG_E
OUTPUTLOG
QUIT
@ZZBH0X1
#FUNCTION
A += 1
B = B*10+1
PRINTFORML ARG B_LENNEG_E SLOT=1 COUNT={A} ORDER={B}
RETURNF 1
@ZZBH0X2
#FUNCTION
A += 1
B = B*10+2
PRINTFORML ARG B_LENNEG_E SLOT=2 COUNT={A} ORDER={B}
RETURNF 3
@ZZBH0X3
#FUNCTION
A += 1
B = B*10+3
PRINTFORML ARG B_LENNEG_E SLOT=3 COUNT={A} ORDER={B}
RETURNF -1
