@SYSTEM_TITLE
#DIMS ZZBHOUT
PRINTL BEGIN H_UNCLOSED_M
OUTPUTLOG
A=0
B=0
RESULT:0=777
RESULTS:0 = SENTINEL
ZZBHOUT = OUT_SENTINEL
PRINTL BEFORE H_UNCLOSED_M
OUTPUTLOG
HTML_TOPLAINTEXT ZZBH0X1()
PRINTFORML AFTER H_UNCLOSED_M R={RESULT:0} SK={RESULTS:0 == "SENTINEL"} OK={ZZBHOUT == "OUT_SENTINEL"} ON={STRLENSU(ZZBHOUT)} SN={STRLENSU(RESULTS:0)}
PRINTFORML EVAL H_UNCLOSED_M COUNT={A} ORDER={B}
PRINTFORML VALUE H_UNCLOSED_M OUT=[%ZZBHOUT%] STR=[%RESULTS:0%]
OUTPUTLOG
PRINTL DONE H_UNCLOSED_M
OUTPUTLOG
QUIT
@ZZBH0X1
#FUNCTIONS
A += 1
B = B*10+1
PRINTFORML ARG H_UNCLOSED_M SLOT=1 COUNT={A} ORDER={B}
RETURNF "<b"
