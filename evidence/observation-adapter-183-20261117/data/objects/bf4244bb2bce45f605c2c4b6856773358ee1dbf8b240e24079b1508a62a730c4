@SYSTEM_TITLE
#DIM ZZFNARR,4
#DIM ZZFNOUT
#DIM ZZFNSENT
PRINTL BEGIN N4_EMPTY_R0
OUTPUTLOG
ZZFNARR:0=1
ZZFNARR:1=2
ZZFNARR:2=1
ZZFNARR:3=0
ZZFNOUT=888
ZZFNSENT=999
RESULT:0=777
RESULT:1=776
RESULTS:0 = FN_NUMERIC_SENTINEL
A=0
B=0
PRINTFORML INIT N4_EMPTY_R0_R0 SIZE={VARSIZE("ZZFNARR")} DATA={ZZFNARR:0},{ZZFNARR:1},{ZZFNARR:2},{ZZFNARR:3} REF0={ZZFNARR:0} R={RESULT:0} R1={RESULT:1} SK={RESULTS:0 == "FN_NUMERIC_SENTINEL"} OUT={ZZFNOUT} SENT={ZZFNSENT}
PRINTL BEFORE N4_EMPTY_R0_R0
OUTPUTLOG
ZZFNOUT=FINDELEMENT(ZZFNARR:ZZFNH0X1(),ZZFNH0X2(),ZZFNH0X3(),ZZFNH0X4(),ZZFNH0X5())
PRINTFORML AFTER N4_EMPTY_R0_R0 OUT={ZZFNOUT} R={RESULT:0} R1={RESULT:1} SK={RESULTS:0 == "FN_NUMERIC_SENTINEL"} SENT={ZZFNSENT}
PRINTFORML ARRAY N4_EMPTY_R0_R0 SIZE={VARSIZE("ZZFNARR")} DATA={ZZFNARR:0},{ZZFNARR:1},{ZZFNARR:2},{ZZFNARR:3} REF0={ZZFNARR:0}
PRINTFORML EVAL N4_EMPTY_R0_R0 COUNT={A} ORDER={B}
PRINTL FOLLOW N4_EMPTY_R0_R0
OUTPUTLOG
PRINTL DONE N4_EMPTY_R0
OUTPUTLOG
QUIT
@ZZFNH0X1
#FUNCTION
A+=1
B=B*10+1
PRINTFORML ARG N4_EMPTY_R0_R0 SLOT=1 VALUE=0 COUNT={A} ORDER={B}
RETURNF 0
@ZZFNH0X2
#FUNCTION
A+=1
B=B*10+2
PRINTFORML ARG N4_EMPTY_R0_R0 SLOT=2 VALUE=1 COUNT={A} ORDER={B}
RETURNF 1
@ZZFNH0X3
#FUNCTION
A+=1
B=B*10+3
PRINTFORML ARG N4_EMPTY_R0_R0 SLOT=3 VALUE=2 COUNT={A} ORDER={B}
RETURNF 2
@ZZFNH0X4
#FUNCTION
A+=1
B=B*10+4
PRINTFORML ARG N4_EMPTY_R0_R0 SLOT=4 VALUE=2 COUNT={A} ORDER={B}
RETURNF 2
@ZZFNH0X5
#FUNCTION
A+=1
B=B*10+5
PRINTFORML ARG N4_EMPTY_R0_R0 SLOT=5 VALUE=1 COUNT={A} ORDER={B}
RETURNF 1
