@SYSTEM_TITLE
PRINTL SETUP_EXPECT_NO10_AND_NUMERIC_INDICES_ONLY
A=0
B=0
RESULT=777
RESULTS = SENTINEL
PRINTL BEFORE_CSVBASE_CMD_NEGATIVE_0
CSVBASE ZZC0H0(),ZZC0H1()
PRINTFORML AFTER_CSVBASE_CMD_NEGATIVE_0 VALUE={RESULT} INT={RESULT} STR=[%RESULTS%] COUNT={A} ORDER={B}
PRINTL DONE_CSVBASE_CMD_NEGATIVE
QUIT
@ZZC0H0
#FUNCTION
A+=1
B=B*10+1
PRINTFORML HELPER_1 COUNT={A} ORDER={B}
RETURNF 10
@ZZC0H1
#FUNCTION
A+=1
B=B*10+2
PRINTFORML HELPER_2 COUNT={A} ORDER={B}
RETURNF -1
