@SYSTEM_TITLE
#DIMS ZZUCOUT
STR:4 '= "\\u0041"
STR:5 '= "\\uD800"
STR:6 '= "\\uD83D"
STR:7 '= "\\uDE00"
STR:8 '= "\\uFFFD"
PRINTL BEGIN UNICODEBYTE_NORMAL_EXPR
OUTPUTLOG
A=0
B=0
C=-999
D=-888
RESULT:0=777
RESULTS:0 = SENTINEL
ZZUCOUT = OUT_SENTINEL
PRINTL BEFORE UNICODEBYTE_NORMAL_EXPR_SUPPLEMENTARY
OUTPUTLOG
D=UNICODEBYTE(ZZUC0X1())
PRINTFORML AFTER UNICODEBYTE_NORMAL_EXPR_SUPPLEMENTARY D={D} R={RESULT:0} SKEEP={RESULTS:0 == "SENTINEL"} SLEN={STRLENSU(RESULTS:0)} N={STRLENSU(ZZUCOUT)} COUNT={A} ORDER={B}
PRINTFORML UNITS UNICODEBYTE_NORMAL_EXPR_SUPPLEMENTARY A={STRCOUNT(ZZUCOUT,STR:4)} D800={STRCOUNT(ZZUCOUT,STR:5)} HIGH={STRCOUNT(ZZUCOUT,STR:6)} LOW={STRCOUNT(ZZUCOUT,STR:7)} REPL={STRCOUNT(ZZUCOUT,STR:8)}
PRINTFORML RAW UNICODEBYTE_NORMAL_EXPR_SUPPLEMENTARY OUT=[%ZZUCOUT%] RESULTS=[%RESULTS:0%]
OUTPUTLOG
A=0
B=0
C=-999
D=-888
RESULT:0=777
RESULTS:0 = SENTINEL
ZZUCOUT = OUT_SENTINEL
PRINTL BEFORE UNICODEBYTE_NORMAL_EXPR_HIRAGANA
OUTPUTLOG
D=UNICODEBYTE(ZZUC1X1())
PRINTFORML AFTER UNICODEBYTE_NORMAL_EXPR_HIRAGANA D={D} R={RESULT:0} SKEEP={RESULTS:0 == "SENTINEL"} SLEN={STRLENSU(RESULTS:0)} N={STRLENSU(ZZUCOUT)} COUNT={A} ORDER={B}
PRINTFORML UNITS UNICODEBYTE_NORMAL_EXPR_HIRAGANA A={STRCOUNT(ZZUCOUT,STR:4)} D800={STRCOUNT(ZZUCOUT,STR:5)} HIGH={STRCOUNT(ZZUCOUT,STR:6)} LOW={STRCOUNT(ZZUCOUT,STR:7)} REPL={STRCOUNT(ZZUCOUT,STR:8)}
PRINTFORML RAW UNICODEBYTE_NORMAL_EXPR_HIRAGANA OUT=[%ZZUCOUT%] RESULTS=[%RESULTS:0%]
OUTPUTLOG
PRINTL DONE UNICODEBYTE_NORMAL_EXPR
OUTPUTLOG
QUIT
@ZZUC0X1
#FUNCTIONS
A += 1
B = B*10+1
PRINTFORML ARG UNICODEBYTE_NORMAL_EXPR_SUPPLEMENTARY SLOT=1 COUNT={A} ORDER={B}
RETURNF "😀"
@ZZUC1X1
#FUNCTIONS
A += 1
B = B*10+1
PRINTFORML ARG UNICODEBYTE_NORMAL_EXPR_HIRAGANA SLOT=1 COUNT={A} ORDER={B}
RETURNF "あ"
