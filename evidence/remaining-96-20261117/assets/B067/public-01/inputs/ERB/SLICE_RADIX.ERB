@SYSTEM_TITLE
A=0
B=0
C=0
RESULT=777
RESULTS = SENTINEL
PRINTL BEFORE SUBSTRING_METHOD_UTF16_HIGH
OUTPUTLOG
SUBSTRING ZZARG1(),ZZARG2(),ZZARG3()
PRINTFORML AFTER SUBSTRING_METHOD_UTF16_HIGH COUNT={A} ORDER={B} INT={RESULT} LEN={STRLENSU(RESULTS)} HIGH={STRCOUNT(RESULTS,"\\uD83D")} LOW={STRCOUNT(RESULTS,"\\uDE00")} REPLACEMENT={STRCOUNT(RESULTS,"\\uFFFD")} CTRL_A={STRCOUNT("A","\\u0041")} CTRL_B={STRCOUNT("B","\\u0041")}
OUTPUTLOG
QUIT
@ZZARG1
#FUNCTIONS
A += 1
B=B*10+1
PRINTFORML ARG1 COUNT={A} ORDER={B} INT={RESULT} STR=[%RESULTS%]
; Function-context observer does not call OUTPUTLOG
RETURNF "A😀B"
@ZZARG2
#FUNCTION
A += 1
B=B*10+2
PRINTFORML ARG2 COUNT={A} ORDER={B} INT={RESULT} STR=[%RESULTS%]
; Function-context observer does not call OUTPUTLOG
RETURNF 1
@ZZARG3
#FUNCTION
A += 1
B=B*10+3
PRINTFORML ARG3 COUNT={A} ORDER={B} INT={RESULT} STR=[%RESULTS%]
; Function-context observer does not call OUTPUTLOG
RETURNF 1
