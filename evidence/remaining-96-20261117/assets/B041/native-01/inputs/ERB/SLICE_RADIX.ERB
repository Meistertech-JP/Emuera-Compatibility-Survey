@SYSTEM_TITLE
A=0
B=0
C=0
RESULT=777
RESULTS = SENTINEL
PRINTL BEFORE SUBSTRINGU_EXPR_UTF16_LOW
OUTPUTLOG
STR:0 '= SUBSTRINGU(ZZARG1(),ZZARG2(),ZZARG3())
PRINTFORML AFTER SUBSTRINGU_EXPR_UTF16_LOW COUNT={A} ORDER={B} INT={RESULT} LEN={STRLENSU(STR:0)} HIGH={STRCOUNT(STR:0,"\\uD83D")} LOW={STRCOUNT(STR:0,"\\uDE00")} REPLACEMENT={STRCOUNT(STR:0,"\\uFFFD")} CTRL_A={STRCOUNT("A","\\u0041")} CTRL_B={STRCOUNT("B","\\u0041")} RS=[%RESULTS%]
OUTPUTLOG
QUIT
@ZZARG1
#FUNCTIONS
A += 1
B=B*10+1
PRINTFORML ARG1 COUNT={A} ORDER={B} INT={RESULT} STR=[%RESULTS%]
; Function-context observer does not call OUTPUTLOG
RETURNF "A😀B"
@ZZARG2
#FUNCTION
A += 1
B=B*10+2
PRINTFORML ARG2 COUNT={A} ORDER={B} INT={RESULT} STR=[%RESULTS%]
; Function-context observer does not call OUTPUTLOG
RETURNF 2
@ZZARG3
#FUNCTION
A += 1
B=B*10+3
PRINTFORML ARG3 COUNT={A} ORDER={B} INT={RESULT} STR=[%RESULTS%]
; Function-context observer does not call OUTPUTLOG
RETURNF 1
