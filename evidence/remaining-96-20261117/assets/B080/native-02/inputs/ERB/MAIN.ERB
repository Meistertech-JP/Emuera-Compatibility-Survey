@SYSTEM_TITLE
#DIMS ZZUCOUT
STR:4 '= "\\u0041"
STR:5 '= "\\uD800"
STR:6 '= "\\uD83D"
STR:7 '= "\\uDE00"
STR:8 '= "\\uFFFD"
PRINTL BEGIN UNICODE_D800_CMD
OUTPUTLOG
A=0
B=0
C=-999
D=-888
RESULT:0=777
RESULTS:0 = SENTINEL
ZZUCOUT = OUT_SENTINEL
PRINTL BEFORE UNICODE_D800_CMD_D800
OUTPUTLOG
UNICODE ZZUC0X1()
ZZUCOUT '= RESULTS:0
PRINTFORML AFTER UNICODE_D800_CMD_D800 D={D} R={RESULT:0} SKEEP={RESULTS:0 == "SENTINEL"} SLEN={STRLENSU(RESULTS:0)} N={STRLENSU(ZZUCOUT)} COUNT={A} ORDER={B}
PRINTFORML UNITS UNICODE_D800_CMD_D800 A={STRCOUNT(ZZUCOUT,STR:4)} D800={STRCOUNT(ZZUCOUT,STR:5)} HIGH={STRCOUNT(ZZUCOUT,STR:6)} LOW={STRCOUNT(ZZUCOUT,STR:7)} REPL={STRCOUNT(ZZUCOUT,STR:8)}
PRINTFORML RAW UNICODE_D800_CMD_D800 OUT=[%ZZUCOUT%] RESULTS=[%RESULTS:0%]
OUTPUTLOG
PRINTL DONE UNICODE_D800_CMD
OUTPUTLOG
QUIT
@ZZUC0X1
#FUNCTION
A += 1
B = B*10+1
PRINTFORML ARG UNICODE_D800_CMD_D800 SLOT=1 COUNT={A} ORDER={B}
RETURNF 55296
