@SYSTEM_TITLE
A=0
B=0
C=0
RESULT=777
RESULTS = SENTINEL
PRINTL BEFORE SUBSTRINGU_EXPR_START_END_PLUS1
OUTPUTLOG
STR:0 '= SUBSTRINGU(ZZARG1(),ZZARG2(),ZZARG3())
PRINTFORML AFTER SUBSTRINGU_EXPR_START_END_PLUS1 COUNT={A} ORDER={B} INT={RESULT} OUT=[%STR:0%] RS=[%RESULTS%]
OUTPUTLOG
