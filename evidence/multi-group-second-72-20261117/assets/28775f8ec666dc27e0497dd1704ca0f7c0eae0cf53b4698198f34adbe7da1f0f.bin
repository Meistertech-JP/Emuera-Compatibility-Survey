@SYSTEM_TITLE
PRINTL BEGIN_gdispose-method-missing
OUTPUTLOG
RESULT = -777
GDISPOSE 231
LOCAL = RESULT
PRINTFORML MISSING={LOCAL}
OUTPUTLOG
RESULT = -777
GDISPOSE 231
LOCAL = RESULT
PRINTFORML MISSING_REPEAT={LOCAL}
OUTPUTLOG
PRINTFORML MISSING_STATE={GCREATED(231)},{GWIDTH(231)},{GHEIGHT(231)}
OUTPUTLOG
PRINTL DONE
OUTPUTLOG
QUIT
