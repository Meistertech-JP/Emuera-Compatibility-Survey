@SYSTEM_TITLE
PRINTL BEGIN235 gdrawgwithmask-expression-missing-dest
OUTPUTLOG
PRINTL TARGET235
OUTPUTLOG
A=0
RESULT=701
RESULTS '= "sentinel235"
B=GDRAWGWITHMASK(ZZ235D(235),ZZ235S(236),ZZ235M(237),ZZ235X(0),0)
PRINTL OBS235
PRINTFORML RET={B}
PRINTFORML RESULT={RESULT}
PRINTFORML RESULTS=%RESULTS%
PRINTFORML EVAL={A}
PRINTFORML P00={GGETCOLOR(235,0,0)}
PRINTFORML P32={GGETCOLOR(235,3,2)}
PRINTL ENDOBS235
OUTPUTLOG
PRINTL DONE235
OUTPUTLOG
QUIT
@ZZ235D(ARG)
#FUNCTION
A=A*10+1
RETURNF ARG
@ZZ235S(ARG)
#FUNCTION
A=A*10+2
RETURNF ARG
@ZZ235M(ARG)
#FUNCTION
A=A*10+3
RETURNF ARG
@ZZ235X(ARG)
#FUNCTION
A=A*10+4
RETURNF ARG
@ZZ235N(ARGS)
#FUNCTIONS
A=A*10+2
RETURNF ARGS
