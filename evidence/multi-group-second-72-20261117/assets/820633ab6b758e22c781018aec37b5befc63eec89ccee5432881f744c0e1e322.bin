@SYSTEM_TITLE
PRINTL BEGIN_gdispose-method-positive
OUTPUTLOG
PRINTL BEFORE_GCREATE
OUTPUTLOG
GCREATE 231,3,2
LOCAL = RESULT
PRINTFORML CREATE={LOCAL}
OUTPUTLOG
PRINTFORML CREATED_STATE={GCREATED(231)},{GWIDTH(231)},{GHEIGHT(231)}
OUTPUTLOG
RESULT = -777
GDISPOSE 231
LOCAL = RESULT
PRINTFORML DISPOSE={LOCAL}
OUTPUTLOG
PRINTFORML AFTER_DISPOSE_STATE={GCREATED(231)},{GWIDTH(231)},{GHEIGHT(231)}
OUTPUTLOG
RESULT = -777
GDISPOSE 231
LOCAL = RESULT
PRINTFORML REPEAT={LOCAL}
OUTPUTLOG
PRINTFORML AFTER_REPEAT_STATE={GCREATED(231)},{GWIDTH(231)},{GHEIGHT(231)}
OUTPUTLOG
LOCAL = GCREATE(231,2,1)
PRINTFORML RECREATE={LOCAL}
OUTPUTLOG
PRINTFORML RECREATED_STATE={GCREATED(231)},{GWIDTH(231)},{GHEIGHT(231)}
OUTPUTLOG
RESULT = -777
GDISPOSE 231
LOCAL = RESULT
PRINTFORML DISPOSE_RECREATED={LOCAL}
OUTPUTLOG
PRINTFORML FINAL_STATE={GCREATED(231)},{GWIDTH(231)},{GHEIGHT(231)}
OUTPUTLOG
PRINTL DONE
OUTPUTLOG
QUIT
