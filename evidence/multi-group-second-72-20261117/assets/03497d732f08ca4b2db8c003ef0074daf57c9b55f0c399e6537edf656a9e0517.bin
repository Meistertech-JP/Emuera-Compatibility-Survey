@SYSTEM_TITLE
PRINTL BEGIN_gclear-method-positive
OUTPUTLOG
PRINTL BEFORE_GCREATE
OUTPUTLOG
GCREATE 231,3,2
LOCAL = RESULT
PRINTFORML CREATE={LOCAL}
OUTPUTLOG
PRINTFORML CREATED_STATE={GCREATED(231)},{GWIDTH(231)},{GHEIGHT(231)}
OUTPUTLOG
PRINTFORML INITIAL_PIXELS={GGETCOLOR(231,0,0)},{GGETCOLOR(231,1,1)},{GGETCOLOR(231,2,1)}
OUTPUTLOG
RESULT = -777
GCLEAR 231,4279312947
LOCAL = RESULT
PRINTFORML CLEAR_OPAQUE={LOCAL}
OUTPUTLOG
PRINTFORML OPAQUE_PIXELS={GGETCOLOR(231,0,0)},{GGETCOLOR(231,1,1)},{GGETCOLOR(231,2,1)}
OUTPUTLOG
RESULT = -777
GCLEAR 231,4279312947
LOCAL = RESULT
PRINTFORML CLEAR_REPEAT={LOCAL}
OUTPUTLOG
PRINTFORML REPEAT_PIXELS={GGETCOLOR(231,0,0)},{GGETCOLOR(231,1,1)},{GGETCOLOR(231,2,1)}
OUTPUTLOG
RESULT = -777
GCLEAR 231,0
LOCAL = RESULT
PRINTFORML CLEAR_TRANSPARENT={LOCAL}
OUTPUTLOG
PRINTFORML TRANSPARENT_PIXELS={GGETCOLOR(231,0,0)},{GGETCOLOR(231,1,1)},{GGETCOLOR(231,2,1)}
OUTPUTLOG
PRINTFORML FINAL_STATE={GCREATED(231)},{GWIDTH(231)},{GHEIGHT(231)}
OUTPUTLOG
PRINTL DONE
OUTPUTLOG
QUIT
