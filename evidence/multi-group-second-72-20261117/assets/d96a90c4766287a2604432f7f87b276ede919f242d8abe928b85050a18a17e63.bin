@SYSTEM_TITLE
PRINTL BEGIN_gsetcolor-method-missing
OUTPUTLOG
RESULT = -777
GSETCOLOR 231,4279312947,1,1
LOCAL = RESULT
PRINTFORML MISSING={LOCAL}
OUTPUTLOG
RESULT = -777
GSETCOLOR 231,4279312947,1,1
LOCAL = RESULT
PRINTFORML MISSING_REPEAT={LOCAL}
OUTPUTLOG
RESULT = -777
GSETCOLOR 231,4294967296,2147483648,2147483648
LOCAL = RESULT
PRINTFORML MISSING_SKIPS_INVALID_COLOR_POINT={LOCAL}
OUTPUTLOG
PRINTFORML MISSING_STATE={GCREATED(231)},{GWIDTH(231)},{GHEIGHT(231)}
OUTPUTLOG
PRINTL DONE
OUTPUTLOG
QUIT
